@page "/outstandingorders"
@page "/admin"

@attribute [Authorize]
@inject IViewOutstandingOrdersUseCase viewOutstandingOrdersUseCase
<h3>Outstanding Orders</h3>
<br />

@if (orders != null && orders.Count() > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Date Placed</th>
                <th>Order Id</th>
                <th>Country</th>
                <th>State / Province</th>
                <th>City</th>
                <th>Customer Name</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in orders)
            {
                <OrderItemComponent Order="order" />
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Order> orders;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        orders = viewOutstandingOrdersUseCase.Execute();
    }
}
